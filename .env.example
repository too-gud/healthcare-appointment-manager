# ==== Server ====
PORT=4000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# ==== Database ====
# SQLite (default, zero-config):
DATABASE_URL="file:./dev.db"
# Postgres (recommended for production, needed for SELECT ... FOR UPDATE locking):
# DATABASE_URL="postgresql://user:password@localhost:5432/healthcare"

# ==== Auth ====
JWT_SECRET="replace-with-a-long-random-string"
JWT_EXPIRES_IN="7d"

# ==== LLM (Anthropic) ====
ANTHROPIC_API_KEY="sk-ant-xxxxxxxxxxxxxxxx"
ANTHROPIC_MODEL="claude-sonnet-4-6"

# ==== Email (choose ONE provider setup) ====
# --- Option A: SendGrid via SMTP relay ---
SMTP_HOST="smtp.sendgrid.net"
SMTP_PORT=587
SMTP_USER="apikey"
SMTP_PASS="your-sendgrid-api-key"
EMAIL_FROM="Clinic Appointments <no-reply@yourclinic.com>"

# --- Option B: Mailgun SMTP ---
# SMTP_HOST="smtp.mailgun.org"
# SMTP_PORT=587
# SMTP_USER="postmaster@yourdomain.mailgun.org"
# SMTP_PASS="your-mailgun-smtp-password"

# --- Option C: Gmail (dev only, use an App Password) ---
# SMTP_HOST="smtp.gmail.com"
# SMTP_PORT=587
# SMTP_USER="youraddress@gmail.com"
# SMTP_PASS="your-16-char-app-password"

# ==== Google Calendar OAuth 2.0 ====
# Create credentials at https://console.cloud.google.com/apis/credentials
# Enable "Google Calendar API" for the project first.
GOOGLE_CLIENT_ID="xxxxxxxx.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="xxxxxxxx"
GOOGLE_REDIRECT_URI="http://localhost:4000/api/calendar/oauth/callback"

# ==== Background jobs ====
SLOT_HOLD_MINUTES=5
NOTIFICATION_RETRY_INTERVAL_MIN=5
MEDICATION_REMINDER_CHECK_INTERVAL_MIN=1
